# Copy this file to .env and fill in real values. Never commit .env.

# MongoDB Atlas connection string. Include the database name before the "?".
# Example: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/appointment_manager?retryWrites=true&w=majority&appName=Cluster0
# Special characters in the password must be URL-encoded (e.g. @ -> %40).
MONGODB_URI=

# Port the server listens on. Render injects PORT automatically.
PORT=5000

# development | production
NODE_ENV=development

# Allowed frontend origin(s) for CORS, comma-separated, no trailing slash.
# Example: http://localhost:5173,https://your-frontend.onrender.com
FRONTEND_URL=http://localhost:5173
